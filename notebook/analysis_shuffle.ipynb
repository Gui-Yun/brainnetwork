    "<a id=\"sec-22\"></a>\n",
    "### 2.2 Timepoint Classification and Shuffled Baseline\n",
    "\n",
    "Compare classification accuracy against a label-shuffled baseline.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "b9c26265",
   "metadata": {},
   "outputs": [],
   "source": [
    "accuracies, time_points, accuracy_std, n_folds = classify_by_timepoints(segments_flo, labels_flo)\n",
    "\n",
    "# 进行标签随机打乱的分类分析，作为基线比较\n",
    "labels_shuffled = np.random.permutation(labels_flo)\n",
    "accuracies_shu, time_points_shu, accuracy_std_shu, n_folds_shu = classify_by_timepoints(segments_flo, labels_shuffled)\n",
    "\n",
    "\n",
    "\n",
    "plot_accuracy(time_points=time_points, accuracies=accuracies, baseline=accuracies_shu, accuracy_std=accuracy_std, baseline_std=accuracy_std_shu, save_path=os.path.join(fig_out_dir, \"classification_accuracy.png\"))"
   ]
  },
