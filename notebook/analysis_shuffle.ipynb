     ]
    }
   ],
   "source": [
    "base_dir = \"/beegfs_hdd/data/nfs_share/users/guiyun/nishome/Micedata/\"\n",
    "data_paths = [\"M21_1107\", \"M71_1024\", \"M73_1128\", \"M77_1031\", \"M77_1107\", \"M78_1017\", \"M79_1128\", \"M91_1017\"]\n",
